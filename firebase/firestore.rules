rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isArtist() { return signedIn() && request.auth.token.role == 'artist'; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validArtwork() { return request.resource.data.keys().hasAll(['artistId','name','price','category','status']) && request.resource.data.name is string && request.resource.data.price is number && request.resource.data.price > 0; }
    match /artworks/{artId} { allow read: if resource.data.status == 'published' || isAdmin() || (isArtist() && resource.data.artistId == request.auth.uid); allow create: if isArtist() && request.resource.data.artistId == request.auth.uid && validArtwork(); allow update: if isAdmin() || (isArtist() && resource.data.artistId == request.auth.uid && validArtwork()); allow delete: if isAdmin() || (isArtist() && resource.data.artistId == request.auth.uid); }
    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid) && request.resource.data.role == 'customer';
      allow update: if owns(uid) && request.resource.data.role == resource.data.role;
      allow delete: if owns(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /artists/{uid} {
      allow read: if true;
      allow update: if owns(uid) && isArtist() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','photoUrl','phone','whatsapp','specialties','location','updatedAt']);
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.artistId == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.artistId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusHistory','tracking','updatedAt']))
        || (signedIn() && resource.data.buyerId == request.auth.uid && resource.data.status == 'delivered' && request.resource.data.status == 'received' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','receivedAt','updatedAt']));
      allow delete: if isAdmin();
    }
    match /artistApplications/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow update, delete: if isAdmin(); }
    match /feedback/{id} { allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid; allow read: if resource.data.status == 'approved' || isAdmin(); allow update, delete: if isAdmin(); }
    match /counters/{id} { allow read: if signedIn(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}

